<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CatsRadar" parent="android:Theme.Material.Light.NoActionBar">
        <!-- The colour, not the parent, is what follows dark mode: the platform has no
             Material.DayNight, and window_background has a values-night variant. This is what
             shows behind the system bars and before the first Compose frame. -->
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
